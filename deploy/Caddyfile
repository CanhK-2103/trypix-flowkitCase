{
	admin off
	# This deployment publishes TCP only. Do not advertise unreachable HTTP/3,
	# or start QUIC's separate logger/UDP buffer tuning in the container.
	servers {
		protocols h1 h2
	}
	log {
		output stdout
		format append {
			service edge
			# Caddyfile treats literal null as a string. An unset global placeholder
			# becomes JSON null; the encoder has no run execution context.
			run_id {flowkit.null_context}
			node_id {flowkit.null_context}
			attempt {flowkit.null_context}
			wrap json
		}
	}
}

{$FLOWKIT_DOMAIN} {
	log {
		output stdout
		format append {
			service edge
			run_id {flowkit.null_context}
			node_id {flowkit.null_context}
			attempt {flowkit.null_context}
			wrap json
		}
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# The private gate requires a signed session on every dashboard/API/asset route.
	reverse_proxy gate:8080 {
		# Never trust a client-supplied rate-limit identity.
		header_up X-FlowKit-Client-IP {http.request.remote.host}
	}
}
