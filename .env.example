OPENROUTER_API_KEY=
FAL_KEY=
# Optional separate key with billing:usage:read, auth:keys:read, account:users:read.
# If omitted, accounting uses FAL_KEY. Never expose either key in the dashboard.
FAL_BILLING_KEY=
DATABASE_URL=postgres://flowkit:flowkit@db:5432/flowkit?sslmode=disable
LOG_LEVEL=debug
LOAD_EXAMPLES=true
PORT=8080
WORKER_CONCURRENCY=4
ARTIFACT_DIR=/data/artifacts
