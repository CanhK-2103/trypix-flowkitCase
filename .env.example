OPENROUTER_API_KEY=
FAL_KEY=
# Optional separate key with billing:usage:read, auth:keys:read, account:users:read.
# If omitted, accounting uses FAL_KEY. Never expose either key in the dashboard.
FAL_BILLING_KEY=
DATABASE_URL=postgres://flowkit:flowkit@db:5432/flowkit?sslmode=disable
LOG_LEVEL=debug
LOAD_EXAMPLES=true
PORT=8080
WORKER_CONCURRENCY=4
ARTIFACT_DIR=/data/artifacts

# Optional VPS deployment (compose.production.yaml).
# Generate a random hex database password; it is embedded in a PostgreSQL URL.
POSTGRES_PASSWORD=
FLOWKIT_DOMAIN=
DASHBOARD_USERNAME=reviewer
# bcrypt hash only. Enclose the hash in SINGLE quotes in .env to preserve "$".
# Generate interactively: docker run --rm -it caddy:2.11.7-alpine caddy hash-password
DASHBOARD_PASSWORD_HASH=
